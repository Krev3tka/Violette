package main

func main() {
    const THREE_HOURS_IN_SECONDS: int16 = 2 * 60 * 60 // Const variable
    THREE_HOURS_IN_SECONDS += 60 * 60          // Error: trying to add and assign new value to constant variable

    print(THREE_HOURS_IN_SECONDS)

    let x = 5
    x = 6 // Error: assigning new value to immutable variable

    var y = 5
    y = 7 // Success: assigning new value to mutable variable

    println(THREE_HOURS_IN_SECONDS)
}