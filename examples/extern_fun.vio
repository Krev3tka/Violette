extern func fabs(x: Float64) -> Float64
extern func sqrt(x: Float64) -> Float64
extern func floor(x: Float64) -> Float64

func main() {
    let negative = -64.0

    let positive = fabs(negative)
    println(positive)

    let root = sqrt(positive)
    println(root)

    let pi = 3.14
    println(floor(pi))
}