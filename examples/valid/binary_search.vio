extend [Int] {
    func (arr: Self) binarySearch(target: Int) -> Int {
        var left = 0
        var right = arr.len - 1

        var mid = 0

        while left <= right {
            mid = left + (right - left) / 2
            if arr[mid] == target {
                return mid
            } else if arr[mid] > target {
                right = mid - 1
            } else if arr[mid] < target {
                left = mid + 1
            }
        }

        return -1
    }
}

func main() {
    let arr1: [Int] = [1, 2, 4, 5, 8, 9]
    let target1 = 5

    println(arr1.binarySearch(target1))
}