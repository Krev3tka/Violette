using String (startsWith, endsWith)

extend String {
    func (s: String) get(idx: Int) -> Char {
        if idx >= s.len() || idx < 0 {
            'a'
        } else {
            s[idx]
        }
    }
}

func main() {
    println("Violette".get(0))

    print("Does `Violette` start with `Vio`: ")
    println("Violette".startsWith("Vio"))

    print("Does `Violette` start with `Vim`: ")
    println("Violette".startsWith("Vim"))

    print("Does `Violette` ends with `lette`: ")
    println("Violette".endsWith("lette"))

    print("Does `Violette` ends with `latte`: ")
    println("Violette".endsWith("latte"))
}