func main () {
    let add: func(Int, Int) -> Int = { #0 + #1 }

    let subtract: func(Float64, Float64) -> Float64 = {
        let a = #0
        let b = #1

        a - b
    }

    let multiply: func(Int, Int) -> Int = {
        let x = #0
        let y = #1

        println("First multiplier: " + x.toString())
        println("Second multiplier: " + y.toString())

        x * y
    }

    let div = {
        return #0 / #1
    }(125, 5)

    println(add(5, 7))
    println(subtract(5.0, 7.0))
    println(multiply(5, 7))
    println(div)
}