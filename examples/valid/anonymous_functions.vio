func main () {
    let add: fun(Int, Int) -> Int = { #0 + #1 }

    let subtract: fun(Float64, Float64) -> Float64 = {
        let a = #0
        let b = #1

        a - b
    }

    let multiply: fun(Int, Int) -> Int = {
        let x = #0
        let y = #1

        println("First multiplier: " + x.toString())
        println("Second multiplier: " + y.toString())

        x * y
    }

    let divide: fun(Int, Int) -> Int = {
        return #0 / #1
    }

    println(add(5, 7))
    println(subtract(5.0, 7.0))
    println(multiply(5, 7))
    println(divide(5, 7))
}