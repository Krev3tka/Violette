func is_prime(n: int) [bool] {
    if n <= 1 { return false }
    for i = 2; i * i <= n; i++ {
        if n % i == 0 {
            return false
        }
    }
    return true
}

func main() {
    var count = 0

    for i = 2; i < 1000000; i++ {
        if is_prime(i) {
            count++
        }
    }
    println(count)
}