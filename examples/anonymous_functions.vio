func main () {
    let add = \(x: int, y: int,) => x + y
    let subtract = \x: float64, y: float64 => { x - y }

    let multiply = \x: int, y: int, => {
        println(x)
        println(y)
        x * y
    }

    let divide = \(x: int, y: int)  => {
        return x / y
    }

    let power = \x: float64, y: float64 [float64] => {
        x ** y
    }

    println(add(5, 7))
    println(subtract(5.0, 7.0))
    println(multiply(5, 7))
    println(divide(5, 7))
    println(power(5.0, 7.0))
}