struct Point {
    x: float64,
    y: float64,
}

fun sqrt(n: float64) [float64] {
    if n < 0.0 { return -1.0 }
    if n == 0.0 || n == 1.0 { return n }

    var x = n / 2.0
    var last_x = 0.0

    for x != last_x {
        last_x = x
        x = 0.5 * (x + (n / x))
    }

    return x

}

fun distance(p: Point) [float64] {
    return sqrt((p.x * p.x) + (p.y * p.y))
}

fun main() {
    let p = Point {
        x: 3,
        y: 4,
    }

    let dist = p.distance()

    println(dist)
}