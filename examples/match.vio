variant Response = Win(Int) | Fail(String) | Timeout

func main() {
    let response = Response.Timeout

    let resp = match response {
        Fail(err) => {
            println(err)
            404
        },
        Win(code) => code,
        Response.Timeout => {
            println("Timeout")
            400
        },
    }

    println(resp)
}