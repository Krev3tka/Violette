func map(num: Int, action: func (Int) -> Int) -> Int = action(num)
func filter(num: Int, predicate: func (Int) -> Bool) -> Int {
    return if predicate(num): num else: -1
}

func main() {
    println(
        5 ~> map(* 2) ~> filter((> 0))
    )

    println(
        3 ~> map((* 2)) ~> filter((> 7))
    )
}