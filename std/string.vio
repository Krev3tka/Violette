package String

extern func vio_str_len(s: String) -> Int
extern func vio_str_to_int(s: String) -> Int
extern func vio_str_to_float(s: String) -> Float64

extend String {
    func (s: Self) len() -> Int {
        return vio_str_len(s)
    }

    func (s: Self) isEmpty() -> Bool {
        return s.len() == 0
    }

    func (s: Self) repeat(n: Int) -> String {
        var res = ""

        for i in 0..<n {
            res = res + s
        }

        return res
    }

    func (s: Self) startsWith(prefix: String) -> Bool {
        if prefix.len() > s.len() {
            return false
        }

        for i in 0..<prefix.len() {
            if s[i] != prefix[i] {
                return false
            }
        }

        return true
    }

    func (s: Self) endsWith(suffix: String) -> Bool {
        if suffix.len() > s.len() {
            return false
        }

        let offset = s.len() - suffix.len()

        for i in 0..<suffix.len() {
            if s[offset + i] != suffix[i] {
                return false
            }
        }

        return true
    }

    func (s: Self) toInt() -> Int = vio_str_to_int(s)
    func (s: Self) toFloat() -> Float64 = vio_str_to_float(s)
}