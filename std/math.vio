package Math

extend Float64 {
    func (n: Float64) abs() -> Float64 {
        if n >= 0.0 {
            return n
        }

        return -n
    }

    func (val: Float64) sqrt() -> Float64 {
        if val < 0.0 {
            return -1.0
        }

        if val == 0.0 || val == 1.0 {
            return val
        }

        var guess = val / 2.0
        let epsilon = 0.0000001

        while true {
            let next_guess = 0.5 * (guess + val / guess)
            if (next_guess - guess).abs() < epsilon {
                return next_guess
            }
            guess = next_guess
        }

        return guess
    }

    func (base: Float64) pow(exp: Float64) -> Float64 {
        return base ** exp
    }

    func (n: Float64) sign() -> Int {
        if n < 0.0 {
            return -1
        } else if n == 0.0 {
            return 0
        }

        return 1
    }

    func (a: Float64) hypot(b: Float64) -> Float64 {
        return (a * a + b * b).sqrt()
    }
}

extend Int {
    func (n: Int) isEven() -> Bool {
        return n % 2 == 0
    }

    func (n: Int) isOdd() -> Bool {
        return n % 2 == 1
    }

    func (n: Int) isPositive() -> Bool {
        return n > 0
    }

    func (n: Int) isNegative() -> Bool {
        return n < 0
    }

    func (n: Int) isZero() -> Bool {
        return n == 0
    }

    func (this: Int) min(other: Int) -> Int {
        if this < other {
            return this
        }

        return other
    }

    func (this: Int) max(other: Int) -> Int {
        if this >= other {
            return this
        }

        return other
    }

    func (val: Int) clamp(min: Int, max: Int) -> Int {
        if val < min {
            return min
        }

        if val > max {
            return max
        }

        return val
    }
}