package math

extend Float64 {
    func abs(n: Float64) -> Float64 {
        if n >= 0.0 {
            return n
        }

        return -n
    }

    func sqrt(val: Float64) -> Float64 {
        if val < 0.0 {
            return -1.0
        }

        if val == 0.0 || val == 1.0 {
            return val
        }

        var guess = val / 2.0
        let epsilon = 0.0000001

        while true {
            let next_guess = 0.5 * (guess + val / guess)
            if (next_guess - guess).abs() < epsilon {
                return next_guess
            }
            guess = next_guess
        }

        return guess
    }

    func pow(base: Float64, exp: Float64) -> Float64 {
        return base ** exp
    }

    func sign(n: Float64) -> Int {
        if n < 0 {
            return -1
        } else if n == 0 {
            return 0
        }

        return 1
    }

    func hypot(a: Float64, b: Float64) -> Float64 {
        return sqrt(a * a + b * b)
    }
}

extend Int {
    func is_even(n: Int) -> Bool {
        return n % 2 == 0
    }

    func is_odd(n: Int) -> Bool {
        return n % 2 == 1
    }

    func is_positive(n: Int) -> Bool {
        return n > 0
    }

    func is_negative(n: Int) -> Bool {
        return n < 0
    }

    func is_zero(n: Int) -> Bool {
        return n == 0
    }

    func min(this: Int, other: Int) -> Int {
        if this < other {
            return this
        }

        return other
    }

    func max(this: Int, other: Int) -> Int {
        if this >= other {
            return this
        }

        return other
    }

    func clamp(val: Int, min: Int, max: Int) -> Int {
        if val < min {
            return min
        }

        if val > max {
            return max
        }

        return val
    }
}