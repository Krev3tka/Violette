using os.file (Modes)

func main() {
    let handle = file.open("/home/krev3tka/file.csv", .Read) else err {
        println("Cannot open file: {err}")
        return
    }

    let content = handle.read_line()

    let numbers = content
        .split(", ")
        .map(\s => s.to_int())
        .filter((>18))
        .map((+3))

    println(numbers)
}